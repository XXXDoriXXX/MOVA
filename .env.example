# ============================================================================
# Mova Backend — Environment Configuration
# ============================================================================
#
#  HOW TO USE:
#    cp .env.example .env
#    # Fill in the REQUIRED keys below (marked with [REQUIRED]).
#    # The rest are optional or have sensible local-dev defaults.
#
#  This file is gitignored as `.env` — never commit secrets.
#
#  Schema source of truth: libs/shared-config/src/lib/env.validation.ts
#  Adding a new variable? Add it there AND here, with a comment.
# ============================================================================


# ──────────────────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug


# ──────────────────────────────────────────────────────────────────────────
# Database (Postgres)
# ──────────────────────────────────────────────────────────────────────────
# Default points at the dockerised Postgres declared in docker-compose.yml.
# If you bring your own Postgres (cloud / local install), replace with that URL.
# If you bring your own, also set DATABASE_SSL=true for managed providers.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mova_dev
DATABASE_SSL=false


# ──────────────────────────────────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────────────────────────────────
# Matches the password set in docker-compose.yml. Change BOTH if you rotate.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=mova-dev-redis-pw


# ──────────────────────────────────────────────────────────────────────────
# Auth (JWT)  [REQUIRED in production]
# ──────────────────────────────────────────────────────────────────────────
# 32+ characters. Dev default is fine LOCALLY but Zod refuses NODE_ENV=production
# unless you replace it with a strong random secret. Generate one:
#   openssl rand -hex 32
JWT_SECRET=dev-only-secret-please-replace-in-production-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d


# ──────────────────────────────────────────────────────────────────────────
# Admin panel  [OPTIONAL]
# ──────────────────────────────────────────────────────────────────────────
# Bearer-token password for the admin web UI at http://localhost:5174.
# Leave empty to keep the panel locked (endpoints return 503).
# Generate a strong value: openssl rand -hex 24
ADMIN_PASSWORD=


# ──────────────────────────────────────────────────────────────────────────
# LiveKit (SIP + WebRTC)  [REQUIRED for placing real calls]
# ──────────────────────────────────────────────────────────────────────────
# Sign up at https://livekit.io → Project → Settings → API Keys.
# For UI / REST / WS development without real calls, you can leave fake
# values — POST /v1/calls/start will fail at SIP dial but the rest works.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=changeme-livekit-api-secret-changeme

# SIP trunk for outbound dials. Created in LiveKit dashboard → SIP. Optional
# if you only want to exercise the agent without real PSTN.
SIP_TRUNK_ID=ST_xxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────────────
# AI Providers  [DEEPGRAM is required; LLM/TTS are configurable]
# ──────────────────────────────────────────────────────────────────────────
# Pick which LLM the live-call agent uses. Default is `openai` (needs the
# key below). Other providers route through the LiveKit Inference Gateway —
# billed via your LiveKit account, no extra key needed:
#
#   LLM_PROVIDER=gemini       LLM_MODEL=google/gemini-2.5-flash
#   LLM_PROVIDER=gemini       LLM_MODEL=google/gemini-3-flash
#   LLM_PROVIDER=anthropic    LLM_MODEL=anthropic/claude-3.5-sonnet
#   LLM_PROVIDER=groq         LLM_MODEL=groq/llama-3.1-70b-versatile
#
# To stay 100% off OpenAI: set LLM_PROVIDER=gemini, TTS_PROVIDER=elevenlabs
# (+ ELEVENLABS_API_KEY below), then OPENAI_API_KEY can be blank.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
TTS_PROVIDER=openai

# OpenAI — used for LLM + TTS when their provider is `openai`. Optional
# when both LLM_PROVIDER and TTS_PROVIDER point elsewhere.
#   Get one: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Deepgram — primary STT (speech-to-text)
#   Get one: https://console.deepgram.com/
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ──────────────────────────────────────────────────────────────────────────
# AI Providers (Optional — graceful degradation when absent)
# ──────────────────────────────────────────────────────────────────────────
# ElevenLabs — premium TTS voices. Without it, TTS falls back to OpenAI.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DEFAULT_ELEVENLABS_VOICE_ID=

# Anthropic Claude — LLM fallback when OpenAI is degraded.
ANTHROPIC_API_KEY=

# Groq llama-3.1 — fast suggestions (200ms TTFT). Without it, suggestions are skipped.
GROQ_API_KEY=

# Google Gemini — alternative primary LLM (strong multilingual incl. Ukrainian).
# Get a key at https://aistudio.google.com/apikey  (free tier covers dev usage).
# Switch your account default to Gemini via the mobile app:
#   Settings → AI Provider → Gemini  (or set template defaultLlmProvider="gemini").
GOOGLE_GENERATIVE_AI_API_KEY=


# ──────────────────────────────────────────────────────────────────────────
# Safety (Lakera Guard — prompt injection detection)
# ──────────────────────────────────────────────────────────────────────────
# Without LAKERA_API_KEY the guard fails OPEN (allows everything).
# That's fine for local dev; for prod, set the key and consider LAKERA_FAIL_OPEN=false.
LAKERA_API_KEY=
LAKERA_FAIL_OPEN=true
LAKERA_TIMEOUT_MS=1500


# ──────────────────────────────────────────────────────────────────────────
# Observability (Sentry — optional)
# ──────────────────────────────────────────────────────────────────────────
# Leave blank for local dev to suppress noise.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1


# ──────────────────────────────────────────────────────────────────────────
# Password breach check (HaveIBeenPwned)
# ──────────────────────────────────────────────────────────────────────────
# Set to false to skip HIBP during local dev (faster registration).
# In production keep it true.
HIBP_ENABLED=true
HIBP_TIMEOUT_MS=2000


# ──────────────────────────────────────────────────────────────────────────
# Rate limiting (global throttler)
# ──────────────────────────────────────────────────────────────────────────
RATE_LIMIT_TTL=60
RATE_LIMIT_DEFAULT=100


# ──────────────────────────────────────────────────────────────────────────
# Billing
# ──────────────────────────────────────────────────────────────────────────
FREE_SECONDS_PER_MONTH=300
PAID_PRICE_PER_SECOND_CENTS=1
MAX_CALL_DURATION_SECONDS=3600
MAX_CONCURRENT_CALLS_PER_USER=1


# ──────────────────────────────────────────────────────────────────────────
# Internal service URLs (only needed if you split services across hosts)
# ──────────────────────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://agent-worker:3001
REALTIME_PUBLIC_URL=http://realtime-service:3002
