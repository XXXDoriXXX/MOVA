# Copy to .env.production on the server. Never commit that file.
# Use hex passwords (openssl rand -hex 32) so database/Redis URLs stay valid.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
SETTINGS_ENCRYPTION_KEY=
# Keep bcrypt hashes in single quotes: ADMIN_PASSWORD_HASH='$2b$...'
ADMIN_PASSWORD_HASH=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIP_TRUNK_ID=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GOOGLE_TTS_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
ELEVENLABS_API_KEY=
GROQ_API_KEY=
PUBLIC_API_URL=https://mova.dehimik.org
REALTIME_PUBLIC_URL=https://mova.dehimik.org
FIREBASE_PROJECT_ID=mova-c4f51
GOOGLE_OAUTH_CLIENT_ID=
RESEND_API_KEY=
EMAIL_FROM=
# WayForPay defaults are SANDBOX. Set real merchant credentials before taking payments.
PAYMENT_PROVIDER=wayforpay
MOVA_PORT=8794
