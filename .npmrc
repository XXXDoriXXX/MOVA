# Project-level npm config. Applies to every `npm install` / `npm ci`
# run inside this repo, on the host AND inside containers.
#
# legacy-peer-deps=true
#   The @livekit/agents-plugin-* packages each pin a different exact
#   minor of @livekit/agents (deepgram/elevenlabs/openai are on 1.0.44,
#   google is on 1.4.x). npm@7+ refuses to resolve this conflict by
#   default; legacy-peer-deps tells it to keep the npm@6 behavior of
#   installing-and-warning instead of installing-and-erroring. At
#   runtime the plugins use only @livekit/agents' stable public surface,
#   so npm hoists a single version to the root and everything works.
#
#   When we upgrade all @livekit/* packages to a matched 1.4.x stack
#   in one shot (separate piece of work — needs verifying AgentSession
#   API hasn't drifted), this line can come back out.
legacy-peer-deps=true
