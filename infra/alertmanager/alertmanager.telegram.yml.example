# Example Alertmanager config with Telegram notifications enabled.
# Copy this file to `alertmanager.yml` (replacing the default stub)
# and substitute the placeholders.

global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/telegram.tmpl

route:
  group_by: ['alertname', 'component']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: telegram-default
  routes:
    - matchers:
        - severity = critical
      receiver: telegram-default
      repeat_interval: 1h

receivers:
  - name: telegram-default
    telegram_configs:
      # Replace YOUR_BOT_TOKEN with the bot token from @BotFather.
      - bot_token: 'YOUR_BOT_TOKEN'
        # Replace 123456789 with your numeric chat_id (see /getUpdates).
        chat_id: 123456789
        parse_mode: HTML
        message: '{{ template "telegram.mova" . }}'
        send_resolved: true

inhibit_rules:
  - source_matchers:
      - alertname = ServiceDown
    target_matchers:
      - severity =~ "warning|critical"
    equal: ['component']
