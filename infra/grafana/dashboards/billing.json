{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Signups (5 min)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(increase(mova_signups_total[5m]))", "refId": "A" }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Calls started (5 min, by plan)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by (plan) (increase(mova_calls_started_total[5m]))",
          "refId": "A",
          "legendFormat": "{{ plan }}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Billable seconds (5 min, by plan)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (plan) (increase(mova_billable_seconds_total[5m]))",
          "refId": "A",
          "legendFormat": "{{ plan }}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Signup rate (per hour)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "rate(mova_signups_total[5m]) * 3600",
          "refId": "A",
          "legendFormat": "signups/h"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Billable seconds rate (per minute, by plan)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (plan) (rate(mova_billable_seconds_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "{{ plan }}"
        }
      ],
      "datasource": { "type": "prometheus", "uid": "prometheus" }
    },
    {
      "title": "Billing structured logs (Loki)",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{service=\"api-gateway\"} |= \"billing.\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["mova", "billing"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "title": "Mova — Billing",
  "uid": "mova-billing",
  "version": 1,
  "weekStart": ""
}
