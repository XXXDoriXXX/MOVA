[Unit]
Description=Mova backend (docker compose)
Requires=docker.service
After=docker.service network-online.target
# Wait for network so DNS for Neon (managed Postgres) resolves on boot.
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=__MOVA_HOME__

# Run compose as the unprivileged mova user; docker socket access is
# granted via the `docker` group (set in bootstrap.sh).
User=mova
Group=mova

# We pull images first so a partial pull failure doesn't leave the
# stack half-running on the previous image. Then up -d brings
# everything online. The --remove-orphans flag wipes containers from
# old service names that no longer exist in compose (housekeeping
# after a rename / removal).
ExecStartPre=/usr/bin/docker compose pull --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

# After a successful compose-up, the systemd unit "exits" with
# RemainAfterExit so it stays in `active (exited)` state. The real
# liveness comes from docker's own restart policies on each container.
TimeoutStartSec=300
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
