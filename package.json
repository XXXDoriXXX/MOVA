    "@types/opossum": "^8.1.9",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "ai": "^6.0.182",
    "axios": "^1.6.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.8",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.4.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.3",
    "joi": "^18.0.2",
    "libphonenumber-js": "^1.13.1",
    "livekit-server-sdk": "^2.15.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.3.0",
    "opossum": "^9.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.19.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.28",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
