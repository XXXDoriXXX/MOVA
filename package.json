{
  "name": "@mova-back/source",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "apps/admin"
  ],
  "scripts": {
    "migration:build": "npx nx build shared-database",
    "migration:generate": "npm run migration:build && typeorm migration:generate -d dist/libs/shared-database/src/data-source.js",
    "migration:run": "npm run migration:build && typeorm migration:run -d dist/libs/shared-database/src/data-source.js",
    "migration:revert": "npm run migration:build && typeorm migration:revert -d dist/libs/shared-database/src/data-source.js",
    "migration:show": "npm run migration:build && typeorm migration:show -d dist/libs/shared-database/src/data-source.js",
    "docker:doctor": "sh tools/docker-doctor.sh",
    "docker:up": "docker compose up -d --build",
    "docker:up:prod": "docker compose -f docker-compose.yml up -d --build",
    "docker:down": "docker compose down",
    "docker:nuke": "docker compose down -v",
    "docker:logs": "docker compose logs -f --tail=100",
    "docker:logs:api": "docker compose logs -f --tail=100 api-gateway",
    "docker:logs:realtime": "docker compose logs -f --tail=100 realtime-service",
    "docker:logs:agent": "docker compose logs -f --tail=100 agent-worker",
    "docker:ps": "docker compose ps",
    "docker:rebuild": "docker compose build --no-cache",
    "docker:migrate": "docker compose run --rm migrations",
    "docker:migrate:show": "docker compose run --rm --entrypoint \"\" migrations sh -c \"npx nx build shared-database && npx typeorm migration:show -d dist/libs/shared-database/src/data-source.js\"",
    "docker:migrate:revert": "docker compose run --rm --entrypoint \"\" migrations sh -c \"npx nx build shared-database && npx typeorm migration:revert -d dist/libs/shared-database/src/data-source.js\"",
    "docker:sh:api": "docker compose exec api-gateway sh",
    "docker:sh:pg": "docker compose exec postgres psql -U postgres -d mova_dev",
    "docker:sh:redis": "docker compose exec redis sh -c \"redis-cli -a \\\"$REDIS_PASSWORD\\\" --no-auth-warning\"",
    "_devx": "// see tools/devx/project.json — these mirror common docker compose ops as Nx targets so they show up in nx graph and play nice with the TUI",
    "status": "npx nx run devx:status",
    "logs": "npx nx run devx:logs",
    "logs:errors": "npx nx run devx:logs:errors",
    "tail": "cross-env NX_TUI=true npx nx run devx:tail",
    "logs:api": "npx nx run api-gateway:logs",
    "logs:realtime": "npx nx run realtime-service:logs",
    "logs:agent": "npx nx run agent-worker:logs",
    "restart": "npx nx run devx:restart:all",
    "restart:api": "npx nx run api-gateway:restart",
    "restart:realtime": "npx nx run realtime-service:restart",
    "restart:agent": "npx nx run agent-worker:restart",
    "sh:api": "npx nx run api-gateway:sh",
    "sh:realtime": "npx nx run realtime-service:sh",
    "sh:agent": "npx nx run agent-worker:sh",
    "graph": "npx nx graph",
    "logs:web": "node -e \"console.log('Dozzle: http://localhost:9999'); require('child_process').exec((process.platform==='win32'?'start ':process.platform==='darwin'?'open ':'xdg-open ')+'http://localhost:9999')\"",
    "admin": "node -e \"console.log('Admin: http://localhost:5174'); require('child_process').exec((process.platform==='win32'?'start ':process.platform==='darwin'?'open ':'xdg-open ')+'http://localhost:5174')\"",
    "logs:admin": "npx nx run admin:logs",
    "nx:reset": "npx nx reset",
    "dev": "npm run docker:doctor && npm run nx:reset && npm run docker:up && npm run logs:web"
  },
  "private": true,
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.77",
    "@ai-sdk/google": "^3.0.77",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.63",
    "@keyv/redis": "^5.1.6",
    "@livekit/agents": "^1.0.44",
    "@livekit/agents-plugin-deepgram": "^1.0.44",
    "@livekit/agents-plugin-elevenlabs": "^1.0.44",
    "@livekit/agents-plugin-google": "^1.4.4",
    "@livekit/agents-plugin-openai": "^1.0.44",
    "@livekit/agents-plugin-silero": "^1.0.44",
    "@livekit/rtc-node": "^0.13.28",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.1.0",
