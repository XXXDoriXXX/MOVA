    "@swc/helpers": "~0.5.18",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "20.19.9",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^11.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.8.0",
